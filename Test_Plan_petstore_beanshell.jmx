            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor - Extract Name (Substring)">
              <stringProp name="script">// 1. Extracting the logged-in user&apos;s name using substring()
String response = prev.getResponseDataAsString();

String marker = &quot;Welcome &quot;;
int start = response.indexOf(marker);

if (start &gt;= 0) {
    start = start + marker.length();
    int end = response.indexOf(&quot;!&quot;, start);
    log.info(&quot;DEBUG - start: &quot; + start);
    log.info(&quot;DEBUG - end: &quot; + end);
    log.info(&quot;DEBUG - text length: &quot; + response.length());

    if (end &gt; start) {
        String fullName = response.substring(start, end);
        vars.put(&quot;fullName_substring&quot;, fullName);
        log.info(&quot;Extracted Name (substring): &quot; + fullName);
    } else {
        log.warn(&quot;Could not locate end marker &apos;!&apos; for substring extraction&quot;);
    }
} else {
    log.warn(&quot;&apos;Welcome &apos; marker not found in response - substring extraction skipped&quot;);
}</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor - Extract Name (Regex)">
              <stringProp name="script">// 2. Pattern matching with regex to extract the logged-in user&apos;s name
import java.util.regex.Pattern;
import java.util.regex.Matcher;

String response = prev.getResponseDataAsString();
Pattern pattern = Pattern.compile(&quot;Welcome\\s+([A-Za-z]+)!&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    String fullName = matcher.group(1);
    vars.put(&quot;fullName_regex&quot;, fullName);
    log.info(&quot;Extracted Name (regex): &quot; + fullName);
} else {
    log.warn(&quot;No match found for &apos;Welcome &lt;name&gt;!&apos; pattern - regex extraction skipped&quot;);
}</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion-String Comparison">
              <stringProp name="BeanShellAssertion.query">String response = prev.getResponseDataAsString();
String expectedName = &quot;SOWNDARIYA&quot;;

if (response.contains(&quot;Welcome &quot; + expectedName + &quot;!&quot;)) {
    log.info(&quot;Login confirmation found for user: &quot; + expectedName);
} else {
    Failure = true;
    FailureMessage = &quot;Expected welcome message for &apos;&quot; + expectedName + &quot;&apos; was not found in the response&quot;;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion - Response Duration">
              <stringProp name="BeanShellAssertion.query">long responseTime = prev.getTime();
long maxAllowedMs = 2000;

if (responseTime &gt; maxAllowedMs) {
    Failure = true;
    FailureMessage = &quot;Response time &quot; + responseTime + &quot; ms exceeded the &quot; + maxAllowedMs + &quot; ms threshold&quot;;
} else {
    log.info(&quot;Response time OK: &quot; + responseTime + &quot; ms&quot;);
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion - Content-Type Header">
              <stringProp name="BeanShellAssertion.query">String headers = prev.getResponseHeaders();
String contentTypeLine = &quot;&quot;;

if (headers != null) {
    String[] lines = headers.split(&quot;\n&quot;);
    for (String line : lines) {
        if (line.toLowerCase().startsWith(&quot;content-type&quot;)) {
            contentTypeLine = line.trim();
            break;
        }
    }
}

if (contentTypeLine.equals(&quot;&quot;) || !contentTypeLine.toLowerCase().contains(&quot;text/html&quot;)) {
    Failure = true;
    FailureMessage = &quot;Invalid or missing Content-Type header: &quot; + contentTypeLine;
} else {
    log.info(&quot;Content-Type header validated: &quot; + contentTypeLine);
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
