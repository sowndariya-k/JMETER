            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor-Extract CSRF Token">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;name=\&quot;_token\&quot; value=\&quot;([^\&quot;]+)\&quot;&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    String token = matcher.group(1);
    vars.put(&quot;csrfToken&quot;, token);
    log.info(&quot;Correlation: extracted _token=&quot; + token + &quot; from purchase.php response for use in confirmation.php&quot;);
} else {
    vars.put(&quot;csrfToken&quot;, &quot;&quot;);
    log.error(&quot;Correlation failed: _token not found in purchase.php response.&quot;);
}
</stringProp>
            </BeanShellPostProcessor>
