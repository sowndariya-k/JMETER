            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion-Task8 total cost validation">
              <stringProp name="BeanShellAssertion.query">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String response = prev.getResponseDataAsString();
double threshold = 700.0;

Pattern pattern = Pattern.compile(&quot;Amount&lt;/td&gt;\\s*&lt;td&gt;([0-9]+\\.?[0-9]*)\\s*USD&quot;);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    String costStr = matcher.group(1);
    double totalCost = Double.parseDouble(costStr);

    log.info(&quot;Extracted total cost: $&quot; + totalCost + &quot; | Threshold: $&quot; + threshold);

    if (totalCost &gt; threshold) {
        Failure = true;
        FailureMessage = &quot;Total cost $&quot; + totalCost + &quot; exceeds approved threshold of $&quot; + threshold;
        log.error(FailureMessage);
    } else {
        log.info(&quot;Cost check passed: $&quot; + totalCost + &quot; is within the approved threshold.&quot;);
    }
} else {
    Failure = true;
    FailureMessage = &quot;Could not locate total cost in the Purchase confirmation response.&quot;;
    log.error(FailureMessage);
}
</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor-Task10 Exception Handling">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

log.info(&quot;Starting response parsing for sampler: &quot; + prev.getSampleLabel());

try {
    String response = prev.getResponseDataAsString();

    if (response == null || response.trim().length() == 0) {
        log.error(&quot;Response is empty or null for sampler: &quot; + prev.getSampleLabel() + &quot;. Skipping parse.&quot;);
    } else {
        log.info(&quot;Response received. Length = &quot; + response.length() + &quot; characters.&quot;);

        Pattern pattern = Pattern.compile(&quot;Amount&lt;/td&gt;\\s*&lt;td&gt;([0-9]+\\.?[0-9]*)\\s*USD&quot;);
        Matcher matcher = pattern.matcher(response);

        if (matcher.find()) {
            String amount = matcher.group(1);
            vars.put(&quot;parsedAmount&quot;, amount);
            log.info(&quot;Successfully parsed amount: $&quot; + amount);
        } else {
            log.info(&quot;No amount pattern found in response - this may be expected for this page.&quot;);
        }
    }

} catch (Exception e) {
    log.error(&quot;Exception occurred while parsing response for sampler: &quot; + prev.getSampleLabel() + &quot; | Error: &quot; + e.getMessage());
}

log.info(&quot;Finished response parsing block (Task 10).&quot;);
</stringProp>
            </BeanShellPostProcessor>
