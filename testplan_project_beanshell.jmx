        <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor-Task6">
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">String[] departCities = {&quot;Boston&quot;, &quot;Dallas&quot;, &quot;Portland&quot;, &quot;New York&quot;, &quot;San Diego&quot;};
String[] destCities   = {&quot;London&quot;, &quot;Paris&quot;, &quot;Berlin&quot;, &quot;Rome&quot;, &quot;Sydney&quot;};

int threadNum = ctx.getThreadNum();
int departIndex = threadNum % departCities.length;
int destIndex   = threadNum % destCities.length;

String departCity = departCities[departIndex];
String destCity    = destCities[destIndex];

vars.put(&quot;departCity&quot;, departCity);
vars.put(&quot;destCity&quot;, destCity);

log.info(&quot;Thread &quot; + threadNum + &quot; assigned Departure=&quot; + departCity + &quot;, Destination=&quot; + destCity);
</stringProp>
        </BeanShellPreProcessor>
