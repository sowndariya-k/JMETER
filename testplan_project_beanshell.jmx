            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor - Task7 extract flightId">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;name=\&quot;flight\&quot; value=\&quot;(\\d+)\&quot;&quot;, Pattern.CASE_INSENSITIVE);
Matcher matcher = pattern.matcher(response);

if (matcher.find()) {
    String flightId = matcher.group(1);
    vars.put(&quot;flightId&quot;, flightId);
    log.info(&quot;Extracted first Flight ID: &quot; + flightId);
} else {
    vars.put(&quot;flightId&quot;, &quot;&quot;);
    log.error(&quot;No Flight ID found in the Find a Flight response.&quot;);
}
</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor - Task9 Count Airline Match">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">String response = prev.getResponseDataAsString();
String targetAirline = &quot;Southwest Airlines&quot;;

String[] rows = response.split(&quot;&lt;tr&gt;&quot;);
int matchCount = 0;

for (int i = 0; i &lt; rows.length; i++) {
    String row = rows[i];
    if (row.indexOf(targetAirline) != -1) {
        matchCount++;
        log.info(&quot;Match found in row &quot; + i + &quot; for airline: &quot; + targetAirline);
    }
}

vars.put(&quot;airlineMatchCount&quot;, String.valueOf(matchCount));
log.info(&quot;Total flights matching &apos;&quot; + targetAirline + &quot;&apos;: &quot; + matchCount);
</stringProp>
            </BeanShellPostProcessor>
