            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;
import java.util.ArrayList;
import java.util.Random;

String text = prev.getResponseDataAsString();

// Extract route
int start = text.indexOf(&quot;Flights from &quot;) + &quot;Flights from &quot;.length();
int end = text.indexOf(&quot;:&quot;, start);
String route = text.substring(start, end);
vars.put(&quot;route&quot;, route);
log.info(&quot;Route:&quot; + route);

// Collect all flight IDs into a list
Pattern pattern = Pattern.compile(&quot;value=\&quot;(\\d+)\&quot;\\s+name=\&quot;flight\&quot;&quot;);
Matcher matcher = pattern.matcher(text);
ArrayList flightIds = new ArrayList();

while (matcher.find()) {
    flightIds.add(matcher.group(1));
}

if (flightIds.size() &gt; 0) {
    Random rand = new Random();
    String flightId = flightIds.get(rand.nextInt(flightIds.size()));
    vars.put(&quot;flightId&quot;, flightId);
    log.info(&quot;Available flightIds: &quot; + flightIds);

    log.info(&quot;Randomly selected flightId:&quot; + flightId);
} else {
    log.warn(&quot;No flightIds found in response&quot;);
}</stringProp>
            </BeanShellPostProcessor>
