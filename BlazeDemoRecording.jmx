              <stringProp name="BeanShellAssertion.query">int code = Integer.parseInt(SampleResult.getResponseCode());
String headers = ResponseHeaders;

if (code != 200) {
    Failure = true;
    FailureMessage = &quot;Expected response code 200, got: &quot; + code;
} else if (!headers.contains(&quot;200 OK&quot;)) {
    Failure = true;
    FailureMessage = &quot;Response headers missing &apos;200 OK&apos; status line&quot;;
} else {
    log.info(&quot;Purchase request passed status checks&quot;);
}</stringProp>
