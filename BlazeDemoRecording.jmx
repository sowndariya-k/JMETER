            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion_launch">
              <stringProp name="BeanShellAssertion.query">String headers = ResponseHeaders.toLowerCase();

if (headers.contains(&quot;content-type&quot;) &amp;&amp; headers.contains(&quot;text/html&quot;)) {
    log.info(&quot;Header check passed: Content-Type is text/html&quot;);
} else {
    Failure = true;
    FailureMessage = &quot;Expected Content-Type: text/html header not found&quot;;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
