    &quot;Wrestling&quot;,
    &quot;Rugby League&quot;,
    &quot;Netball&quot;,
    &quot;Field Hockey&quot;,
    &quot;Skiing&quot;
]

vars.put(&quot;sport&quot;, sports[new Random().nextInt(sports.size())])</stringProp>
